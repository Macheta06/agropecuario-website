{
  "name": "agropecuario-backend",
  "version": "1.0.0",
  "description": "API REST para Catálogo Digital de Ferretería",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node --project tsconfig.scripts.json src/scripts/seeder.ts",
    "scrape": "ts-node --project tsconfig.scripts.json src/scripts/imageScraper.ts",
    "script:clasificar": "ts-node --project tsconfig.scripts.json src/scripts/ai-classifier.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "mongoose": "^9.4.1",
    "openai": "^6.46.0",
    "puppeteer": "^24.40.0",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0",
    "@types/express": "^4.17.21",
    "@types/node": "^25.5.2"
  }
}
